{
  "host": "localhost",
  "port": 3030,
  "public": "../public/",
  "postgres": "postgres://postgres:jenkinsuplink@db:5432/uplink_development",
  "authentication": {
    "secret": "a poorly formed development secret",
    "entity": "user",
    "service": "users",
    "session": true,
    "cookie": {
      "secure": false,
      "enabled": true,
      "name": "uplink-jwt"
    },
    "authStrategies": [
      "jwt",
      "github"
    ],
    "oauth": {
      "defaults": {
        "origin": "http://localhost:3030"
      },
      "github": {}
    }
  },
  "paginate": {
    "default": 10,
    "max": 50
  }
}
