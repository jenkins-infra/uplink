{
  "name": "uplink",
  "version": "1.0.0",
  "description": "Uplink receives bursts of Jenkins telemetry",
  "main": "src/index.js",
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "scripts": {
    "start": "node ./src",
    "build": "tsc",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jenkins-infra/uplink.git"
  },
  "author": "R Tyler Croy",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/jenkins-infra/uplink/issues"
  },
  "homepage": "https://github.com/jenkins-infra/uplink#readme",
  "devDependencies": {
    "@feathersjs/cli": "^3.9.0",
    "@sentry/types": "^4.5.3",
    "@types/jest": "^29.5.14",
    "@types/winston": "^2.4.4",
    "jest": "^29.7.0",
    "nodemon": "^1.19.1",
    "request": "^2.88.2",
    "request-promise": "^4.2.4",
    "sequelize-cli": "^5.5.1",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@feathersjs/authentication": "^5.0.51",
    "@feathersjs/authentication-oauth": "^5.0.52",
    "@feathersjs/configuration": "^5.0.44",
    "@feathersjs/errors": "^5.0.44",
    "@feathersjs/express": "^5.0.51",
    "@feathersjs/feathers": "^5.0.50",
    "@feathersjs/socketio": "^5.0.51",
    "@sentry/node": "^4.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.3",
    "cors": "^2.8.4",
    "event-stream": "^3.3.4",
    "feathers-memory": "^2.2.0",
    "feathers-sequelize": "^7.0.3",
    "helmet": "^3.13.0",
    "jsonstream": "^1.0.3",
    "pg": "^8.16.0",
    "pg-query-stream": "^4.10.0",
    "pug": "^2.0.4",
    "sequelize": "^5.22.5",
    "serve-favicon": "^2.5.0",
    "tslib": "^2.8.1",
    "uuid": "^3.3.2",
    "winston": "^3.1.0"
  },
  "overrides": {
    "config": "4.4.2"
  },
  "jest": {
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "text"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testMatch": [
      "**/__tests__/**/*.ts?(x)",
      "**/?(*.)+(spec|test).ts?(x)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
